{
    "name": "topskip",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "TopSkip backend and Chrome extension workspace",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "setup": "pnpm install",
        "build": "rspack build --config extension/rspack.config.ts",
        "build:watch": "rspack build --config extension/rspack.config.ts --watch",
        "backend:dev": "tsx backend/src/server.ts",
        "yt-dlp:install": "tsx scripts/yt-dlp-manager.ts install",
        "yt-dlp:refresh-pin": "tsx scripts/refresh-yt-dlp-pin.ts",
        "dev": "tsx scripts/build-extension.ts dev",
        "beta": "tsx scripts/build-extension.ts beta",
        "release": "tsx scripts/build-extension.ts release",
        "validate:extension-manifest": "tsx scripts/validate-extension-manifest.ts",
        "format": "eslint --fix .",
        "format:check": "pnpm lint",
        "check": "pnpm lint && pnpm lint:md && pnpm typecheck",
        "lint": "eslint .",
        "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules/**\" \"#extension/dist/**\" \"#**/coverage/**\" \"#.sdd/**\" \"#**/test-results/**\" \"#**/tmp/**\"",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:deployment": "bash deploy/tests/deployment-assets.test.sh",
        "test:container": "bash deploy/tests/container-smoke.sh",
        "test:e2e": "playwright test --config extension/playwright.config.ts",
        "test:e2e:ui": "playwright test --config extension/playwright.config.ts --ui",
        "generate:e2e-video": "bash scripts/generate-e2e-fixture-video.sh",
        "openrouter:compare-presets": "tsx scripts/compare-openrouter-presets.ts",
        "benchmark:promo": "tsx scripts/promo-benchmark.ts",
        "openrouter:extract-log-transcript": "tsx scripts/extract-transcript-from-topskip-console-log.ts",
        "locales": "tsx scripts/translations/index.ts"
    },
    "engines": {
        "node": ">=22"
    },
    "devDependencies": {
        "@adguard/translate": "^2.0.1",
        "@axe-core/playwright": "^4.11.1",
        "@eslint/js": "10.0.1",
        "@playwright/test": "^1.59.1",
        "@rspack/cli": "^1.7.11",
        "@rspack/core": "^1.7.11",
        "@topskip/extension": "workspace:*",
        "@types/chrome": "^0.1.40",
        "@types/dom-chromium-ai": "^0.0.16",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@types/webextension-polyfill": "^0.12.5",
        "@vitest/coverage-v8": "^4.1.4",
        "commander": "^14.0.3",
        "css-loader": "^7.1.4",
        "dotenv": "^17.4.2",
        "eslint": "10.11.0",
        "eslint-config-airbnb-extended": "3.2.0",
        "eslint-plugin-jsdoc": "64.5.4",
        "globals": "17.12.0",
        "markdownlint-cli2": "^0.22.0",
        "serve": "^14.2.6",
        "tsx": "^4.21.0",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.1",
        "valibot": "^1.3.1",
        "vitest": "^4.1.4"
    }
}
