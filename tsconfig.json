{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "types": ["chrome", "node", "dom-chromium-ai"],
        "paths": {
            "@/*": ["./extension/src/*"],
            "@topskip/backend/*": ["./backend/src/*"],
            "@topskip/common/*": ["./common/src/*"]
        }
    },
    "include": [
        "backend/src/**/*.ts",
        "backend/tests/**/*.ts",
        "common/src/**/*.ts",
        "common/tests/**/*.ts",
        "extension/build-modes.ts",
        "extension/manifest-profile.ts",
        "extension/src/**/*.ts",
        "extension/src/**/*.tsx",
        "extension/src/**/*.d.ts",
        "extension/tests/**/*.ts",
        "extension/rspack.config.ts",
        "extension/playwright.config.ts",
        "deploy/rspack.config.ts",
        "vitest.config.ts",
        "scripts/**/*.ts"
    ],
    "exclude": ["node_modules", "extension/dist"]
}
